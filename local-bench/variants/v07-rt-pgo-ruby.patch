index 6a935fc0ac157e5ab4dfde4d4475a59787b05d0e..9426aa97b3597c1f15275f3e7700c2f9d62ab234 100755
--- a/install.sh
+++ b/install.sh
@@ -1,6 +1,6 @@
 #!/usr/bin/env bash
 # Runs once as root on a clean Ubuntu 24.04. Builds from pinned, checksummed sources:
-#   Ruby 4.0 (YJIT, jemalloc) under /opt/ruby, SQLite 3.54 (static, tuned) under /opt/sqlite,
+#   Ruby 4.0 (YJIT, jemalloc, profile-guided) under /opt/ruby, SQLite 3.54 (static, tuned) under /opt/sqlite,
 #   libsodium 1.0.22 under /usr/local.
 set -euo pipefail
 export DEBIAN_FRONTEND=noninteractive
@@ -62,14 +62,46 @@ fi
 
 RUBY_VERSION=4.0.7
 RUBY_SHA256=911ace20f90d068ca0e4dda6d0e4f0f81e52e52f2dd4f4004c721e253412e82d
-if [ "$(/opt/ruby/bin/ruby -e 'print RUBY_VERSION' 2>/dev/null)" != "$RUBY_VERSION" ]; then
+# Profile-guided, like SQLite: pass 1 is instrumented, ruby_train.rb runs the server's own request
+# path on it under the pinned gems, and pass 2 rebuilds from a fresh tree at the same path (the
+# profile is keyed by object path). XCFLAGS reach only Ruby's own objects, not rbconfig's cflags, so
+# the gems build.sh compiles later stay clean.
+if ! grep -qx "$RUBY_VERSION-pgo" /opt/ruby/VERSION 2>/dev/null; then
+  for f in ruby_train.rb app.rb http.rb epoll.rb Gemfile Gemfile.lock; do
+    [ -f "$here/$f" ] || { echo "install.sh: $here/$f is needed to train the Ruby build" >&2; exit 1; }
+  done
   fetch "https://cache.ruby-lang.org/pub/ruby/4.0/ruby-$RUBY_VERSION.tar.gz" "$RUBY_SHA256" ruby.tar.gz
-  cd "$work"
-  tar -xzf ruby.tar.gz
-  cd "ruby-$RUBY_VERSION"
-  ./configure --prefix=/opt/ruby --enable-yjit --with-jemalloc --disable-install-doc --disable-install-rdoc \
-    cflags="$NATIVE"
+  CONFIGURE=(--enable-yjit --with-jemalloc --disable-install-doc --disable-install-rdoc cflags="$NATIVE")
+  pgo="$work/rbpgo"
+  instrumented="$work/ruby-instrumented"
+  cd "$work" && tar -xzf ruby.tar.gz && cd "ruby-$RUBY_VERSION"
+  # LDFLAGS, not XLDFLAGS: mkmf's link checks for the bundled extensions link the instrumented
+  # libruby-static and need libgcov, or every have_func() fails and ext/json refuses to compile.
+  ./configure "${CONFIGURE[@]}" --prefix="$instrumented" \
+    XCFLAGS="-fprofile-generate -fprofile-update=atomic -fprofile-dir=$pgo" LDFLAGS="-fprofile-generate"
   make -j"$(nproc)"
   make install
+  # The trainer runs the exact gem stack of Gemfile.lock (bundler, ruby platform), built against the
+  # instrumented interpreter in a scratch path. Nothing of it is kept.
+  bundle_env=(BUNDLE_GEMFILE="$here/Gemfile" BUNDLE_PATH="$work/train-gems" BUNDLE_APP_CONFIG="$work/train-bundle"
+    BUNDLE_FROZEN=true BUNDLE_FORCE_RUBY_PLATFORM=true BUNDLE_BUILD__EXTRALITE=--with-sqlite3-dir=/opt/sqlite)
+  env "${bundle_env[@]}" "$instrumented/bin/bundle" install --jobs "$(nproc)"
+  rm -rf "$pgo" # discard what the build and the gem installs recorded; only the training run counts
+  env "${bundle_env[@]}" "$instrumented/bin/ruby" --yjit --yjit-call-threshold=5 -rbundler/setup \
+    "$here/ruby_train.rb" "$work/train-ruby.db"
+  # The profile must cover the interpreter's hot objects, not just a warm-up.
+  for o in vm string gc hash array object io; do
+    f="$(ls "$pgo"/*"#$o.gcda" 2>/dev/null | head -1 || true)"
+    [ -s "$f" ] || { echo "install.sh: no Ruby profile for $o.c" >&2; exit 1; }
+  done
+  echo "ruby profile: $(ls "$pgo" | wc -l) objects"
+  cd "$work" && rm -rf "ruby-$RUBY_VERSION" && tar -xzf ruby.tar.gz && cd "ruby-$RUBY_VERSION"
+  ./configure "${CONFIGURE[@]}" --prefix=/opt/ruby \
+    XCFLAGS="-fprofile-use -fprofile-partial-training -fprofile-dir=$pgo -Wno-missing-profile"
+  make -j"$(nproc)"
+  rm -rf /opt/ruby
+  make install
+  echo "$RUBY_VERSION-pgo" > /opt/ruby/VERSION
+  rm -rf "$instrumented" "$work/train-gems"
 fi
