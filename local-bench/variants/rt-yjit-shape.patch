@@ -20,6 +20,33 @@ end
 # Group commit: the first write in a reactor pass opens BEGIN IMMEDIATE and schedules one COMMIT
 # for the next pass. Every write in between joins that transaction, and every response waits for
 # the COMMIT. Reads that run while a batch is open may have seen its rows, so they wait too.
+# The requests of one write transaction park here until COMMIT has returned (so nothing is answered
+# before it is durable): straight to the scheduler, without the Mutex, ConditionVariable and keyword
+# forwarding of Async::Promise, which YJIT could not compile and which cost a C-to-Ruby call per wait.
+class Batch
+  def initialize
+    @fibers = []
+    @outcome = nil
+  end
+
+  def wait
+    unless @outcome
+      @fibers << Fiber.current
+      Fiber.scheduler.transfer
+    end
+    raise @outcome if @outcome.is_a?(Exception)
+
+    @outcome
+  end
+
+  def finish(outcome)
+    @outcome = outcome
+    scheduler = Fiber.scheduler
+    @fibers.each { |fiber| scheduler.unblock(nil, fiber) }
+    @fibers.clear
+  end
+end
+
 class Store
   POST_JSON = "json_object('id',p.id,'body',p.body,'created_at',p.created_at,'author',u.username," \
               "'like_count',(SELECT count(*) FROM likes l WHERE l.post_id=p.id))"
@@ -116,7 +143,7 @@ class Store
     return @batch if @batch
 
     @db.execute("BEGIN IMMEDIATE")
-    batch = @batch = Async::Promise.new
+    batch = @batch = Batch.new
     Async do |task|
       task.yield # let every request that is ready in this pass join the batch
       commit(batch)
@@ -130,9 +157,9 @@ class Store
       @db.execute("COMMIT")
     rescue Extralite::Error => error
       @db.execute("ROLLBACK") if @db.transaction_active?
-      return batch.reject(error)
