   cd "$work"
   tar -xzf ruby.tar.gz
+  # Profile-guided, like SQLite: pass 1 is instrumented (XCFLAGS reach only Ruby's own objects, not
+  # rbconfig's cflags, so gems built later stay clean), ruby_train.rb runs the server's request path
+  # on it, pass 2 rebuilds from a fresh tree at the same path so the profile keys match.
+  CONFIGURE=(--prefix=/opt/ruby --enable-yjit --with-jemalloc --disable-install-doc --disable-install-rdoc cflags="$NATIVE")
+  pgo="$work/rbpgo"
   cd "ruby-$RUBY_VERSION"
-  ./configure --prefix=/opt/ruby --enable-yjit --with-jemalloc --disable-install-doc --disable-install-rdoc \
-    cflags="$NATIVE"
+  # LDFLAGS, not XLDFLAGS: mkmf's link checks for the bundled extensions link the instrumented
+  # libruby-static and need libgcov, or every have_func() fails and ext/json refuses to compile.
+  ./configure "${CONFIGURE[@]}" --prefix="$work/ruby-instrumented" \
+    XCFLAGS="-fprofile-generate -fprofile-update=atomic -fprofile-dir=$pgo" LDFLAGS="-fprofile-generate"
   make -j"$(nproc)"
   make install
+  "$work/ruby-instrumented/bin/gem" install --no-document extralite:3.1.3 -- --with-sqlite3-dir=/opt/sqlite
+  "$work/ruby-instrumented/bin/gem" install --no-document async:2.46.0 io-event:1.22.1 rbnacl:7.1.2 json:3.1.0 ffi:1.17.4
+  rm -rf "$pgo" # discard what the build and gem installs recorded; only the training run counts
+  "$work/ruby-instrumented/bin/ruby" --yjit --yjit-call-threshold=5 "$here/ruby_train.rb" "$work/train-ruby.db"
+  test -n "$(ls -A "$pgo")" || { echo "no profile written" >&2; exit 1; }
+  cd "$work" && rm -rf "ruby-$RUBY_VERSION" && tar -xzf ruby.tar.gz && cd "ruby-$RUBY_VERSION"
+  ./configure "${CONFIGURE[@]}" \
+    XCFLAGS="-fprofile-use -fprofile-partial-training -fprofile-dir=$pgo -Wno-missing-profile"
+  make -j"$(nproc)"
+  make install
+  rm -rf "$work/ruby-instrumented"
 fi
 /opt/ruby/bin/ruby --yjit -e 'abort "YJIT unavailable" unless RubyVM::YJIT.enabled?; puts RUBY_DESCRIPTION'
diff --git a/ruby_train.rb b/ruby_train.rb
new file mode 100644
index 0000000000000000000000000000000000000000..042f835100f04be83653806488917cf5bb6c9018
--- /dev/null
+++ b/ruby_train.rb
@@ -0,0 +1,121 @@
+# frozen_string_literal: true
+# Profile-guided optimization workload for Ruby itself, run by install.sh on an instrumented build.
+# Builds a synthetic database with the challenge schema, then runs the server's own parser, app and
+# reactor: the warm-up mix through HTTPServer#drain, then the load test's request mix over loopback
+# from a forked client against the real reactor. Not part of the server.
+#
+#   ruby --yjit ruby_train.rb <scratch.db>
+require "async"
+require "json"
+require "extralite"
+require_relative "app"
+require_relative "http"
+
+path = ARGV.fetch(0)
+SECRET = "train-secret"
+CLIENTS = 64
+ROUNDS = 800
+File.delete(path) if File.exist?(path)
+db = Extralite::Database.new(path)
+db.execute("PRAGMA journal_mode=WAL")
+db.execute(<<~SQL)
+  CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT NOT NULL UNIQUE,
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')));
+SQL
+db.execute(<<~SQL)
+  CREATE TABLE posts (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id),
+    body TEXT NOT NULL CHECK (length(body) BETWEEN 1 AND 500),
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')));
+SQL
+db.execute(<<~SQL)
+  CREATE TABLE likes (user_id INTEGER NOT NULL REFERENCES users(id), post_id INTEGER NOT NULL REFERENCES posts(id),
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), PRIMARY KEY (user_id, post_id));
+SQL
+db.execute("CREATE INDEX posts_created_at_id_idx ON posts (created_at DESC, id DESC)")
+db.execute("CREATE INDEX posts_user_id_idx ON posts (user_id)")
+db.execute("CREATE INDEX likes_post_id_idx ON likes (post_id)")
+db.execute("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<5000) INSERT INTO users(id,username) SELECT i,'user_'||i FROM n")
+db.execute("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<50000) INSERT INTO posts(id,user_id,body,created_at) " \
+           "SELECT i,1+i%5000,'post body number '||i||' with some text',strftime('%Y-%m-%dT%H:%M:%fZ','2025-01-01','+'||i||' seconds') FROM n")
+db.execute("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<200000) INSERT OR IGNORE INTO likes(user_id,post_id) SELECT 1+(i*7)%5000,1+(i*13)%50000 FROM n")
+db.execute("ANALYZE")
+db.close
+
+key = SECRET.b.ljust(32, "\0")
+sign = lambda do |sub, username|
+  claims = [{ sub: sub.to_s, username: username, exp: Time.now.to_i + 3600 }.to_json].pack("m0").tr("+/", "-_").delete("=")
+  input = "#{App::HS256_HEADER}.#{claims}".b
+  mac = String.new("\0" * 32, encoding: Encoding::BINARY)
+  Sodium.hmac_sha256(mac, input, input.bytesize, key)
+  "#{input}.#{[mac].pack("m0").tr("+/", "-_").delete("=")}"
+end
+tokens = (1..CLIENTS).map { |i| sign.call(i, "user_#{i}") }
+host = "127.0.0.1"
+port = 3100 + rand(1000)
+
+done_r, done_w = IO.pipe
+client = fork do
+  done_r.close
+  srand(7)
+  socks = nil
+  60.times do
+    begin
+      socks = Array.new(CLIENTS) { TCPSocket.new(host, port) }
+      break
+    rescue SystemCallError
+      socks&.each(&:close)
+      sleep 0.5
+    end
+  end
+  read_response = lambda do |s|
+    buf = String.new
+    buf << s.readpartial(8192) until (i = buf.index("\r\n\r\n"))
+    len = buf[/content-length: (\d+)/i, 1].to_i
+    have = buf.bytesize - (i + 4)
+    buf << s.read(len - have) if have < len
+  end
+  ROUNDS.times do
+    socks.each_with_index do |s, k|
+      r = rand
+      s.write(if r < 0.46 then "GET /feed HTTP/1.1\r\nHost: x\r\n\r\n"
+              elsif r < 0.92 then "GET /posts/#{rand(1..50_000)} HTTP/1.1\r\nHost: x\r\n\r\n"
+              elsif r < 0.99 then "POST /posts/#{rand(1..50_000)}/like HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer #{tokens[k]}\r\nContent-Length: 0\r\n\r\n"
+              else body = %({"body":"  a freshly written post body #{k}  "}); "POST /posts HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer #{tokens[k]}\r\nContent-Type: application/json\r\nContent-Length: #{body.bytesize}\r\n\r\n#{body}"
+              end)
+    end
+    socks.each { |s| read_response.call(s) }
+  end
+  socks.each(&:close)
+  exit!(0)
+end
+done_w.close
+
+store = Store.new(path)
+app = App.new(store, SECRET)
+server = HTTPServer.new(app, host, port)
+auth = "Authorization: Bearer #{tokens[0]}\r\n"
+warm = [
+  "GET /feed HTTP/1.1\r\nHost: x\r\n\r\n",
+  "GET /posts/1 HTTP/1.1\r\nHost: x\r\n\r\n",
+  "POST /posts HTTP/1.1\r\nHost: x\r\n#{auth}Content-Length: 11\r\n\r\n{\"body\":\"\"}",
+  "POST /posts/0/like HTTP/1.1\r\nHost: x\r\n#{auth}\r\n",
+  "GET /nope HTTP/1.0\r\nHost: x\r\n\r\n",
+  "GET /posts/abc HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"
+]
+server.warm(warm, 3000)
+GC.compact
+Process.warmup if Process.respond_to?(:warmup)
+
+Async do |task|
+  task.async do
+    loop do
+      sleep 1
+      store.checkpoint
+    end
+  end
+  server.run(task)
+  done_r.wait_readable
+  task.stop
+end
+Process.wait(client)
+$stderr.puts "ruby_train: #{CLIENTS * ROUNDS} reactor requests + #{warm.size * 3000} drained"
