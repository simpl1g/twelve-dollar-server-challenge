diff --git a/ruby_train.rb b/ruby_train.rb
new file mode 100644
index 0000000000000000000000000000000000000000..69d8b9b585338a7d4f4d4cee2859c2bc70f5959b
--- /dev/null
+++ b/ruby_train.rb
@@ -0,0 +1,164 @@
+# frozen_string_literal: true
+# Profile-guided optimization workload for Ruby itself, run by install.sh on an instrumented build.
+# Builds a synthetic database with the challenge schema, then runs the server's own parser, app and
+# reactor: the warm-up mix through HTTPServer#drain, then the load test's request mix over loopback
+# from a forked client against the real reactor. About one request in six ends its connection, so
+# the accept and close paths are profiled too. Not part of the server.
+#
+#   ruby --yjit -rbundler/setup ruby_train.rb <scratch.db>
+require "async"
+require "json"
+require "extralite"
+require_relative "app"
+require_relative "http"
+
+# The pinned stack of Gemfile.lock, so the profile matches what start.sh runs.
+abort "ruby_train: async #{Async::VERSION}, expected 2.46.0" unless Async::VERSION == "2.46.0"
+abort "ruby_train: io-event #{IO::Event::VERSION}, expected 1.22.1" unless IO::Event::VERSION == "1.22.1"
+$stderr.puts "ruby_train: selector #{IO::Event::Selector.default}"
+
+path = ARGV.fetch(0)
+SECRET = "train-secret"
+HOST = "127.0.0.1"
+CLIENTS = 64
+ROUNDS = 800
+WARM_ROUNDS = 3000
+File.delete(path) if File.exist?(path)
+db = Extralite::Database.new(path)
+db.execute("PRAGMA journal_mode=WAL")
+db.execute(<<~SQL)
+  CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT NOT NULL UNIQUE,
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')));
+SQL
+db.execute(<<~SQL)
+  CREATE TABLE posts (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id),
+    body TEXT NOT NULL CHECK (length(body) BETWEEN 1 AND 500),
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')));
+SQL
+db.execute(<<~SQL)
+  CREATE TABLE likes (user_id INTEGER NOT NULL REFERENCES users(id), post_id INTEGER NOT NULL REFERENCES posts(id),
+    created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')), PRIMARY KEY (user_id, post_id));
+SQL
+db.execute("CREATE INDEX posts_created_at_id_idx ON posts (created_at DESC, id DESC)")
+db.execute("CREATE INDEX posts_user_id_idx ON posts (user_id)")
+db.execute("CREATE INDEX likes_post_id_idx ON likes (post_id)")
+db.execute("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<5000) INSERT INTO users(id,username) SELECT i,'user_'||i FROM n")
+db.execute("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<50000) INSERT INTO posts(id,user_id,body,created_at) " \
+           "SELECT i,1+i%5000,'post body number '||i||' with some text',strftime('%Y-%m-%dT%H:%M:%fZ','2025-01-01','+'||i||' seconds') FROM n")
+db.execute("WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i+1 FROM n WHERE i<200000) INSERT OR IGNORE INTO likes(user_id,post_id) SELECT 1+(i*7)%5000,1+(i*13)%50000 FROM n")
+db.execute("ANALYZE")
+db.close
+
+key = SECRET.b.ljust(32, "\0")
+sign = lambda do |sub, username|
+  claims = [{ sub: sub.to_s, username: username, exp: Time.now.to_i + 3600 }.to_json].pack("m0").tr("+/", "-_").delete("=")
+  input = "#{App::HS256_HEADER}.#{claims}".b
+  mac = String.new("\0" * 32, encoding: Encoding::BINARY)
+  Sodium.hmac_sha256(mac, input, input.bytesize, key)
+  "#{input}.#{[mac].pack("m0").tr("+/", "-_").delete("=")}"
+end
+tokens = (1..CLIENTS).map { |i| sign.call(i, "user_#{i}") }
+
+store = Store.new(path)
+app = App.new(store, SECRET)
+server = port = nil
+5.times do
+  port = 3100 + rand(1000)
+  server = HTTPServer.new(app, HOST, port)
+  break
+rescue Errno::EADDRINUSE
+  server = nil
+end
+abort "ruby_train: no free port" unless server
+
+done_r, done_w = IO.pipe
+# The client checks every status, so a profile is only accepted when the server served the whole mix.
+client = fork do
+  done_r.close
+  srand(7)
+  connect = lambda do
+    tries = 0
+    begin
+      TCPSocket.new(HOST, port)
+    rescue SystemCallError
+      raise if (tries += 1) > 60
+
+      sleep 0.5
+      retry
+    end
+  end
+  read_response = lambda do |s|
+    buf = String.new
+    buf << s.readpartial(8192) until (i = buf.index("\r\n\r\n"))
+    len = buf[/content-length: (\d+)/i, 1].to_i
+    have = buf.bytesize - (i + 4)
+    s.read(len - have) if have < len
+    buf[9, 3].to_i
+  end
+  socks = Array.new(CLIENTS) { connect.call }
+  expected = Array.new(CLIENTS)
+  closing = Array.new(CLIENTS)
+  bad = 0
+  ROUNDS.times do
+    socks.each_with_index do |s, k|
+      r = rand
+      request, expected[k] =
+        if r < 0.46 then ["GET /feed HTTP/1.1\r\nHost: x\r\n\r\n", [200]]
+        elsif r < 0.92 then ["GET /posts/#{rand(1..50_000)} HTTP/1.1\r\nHost: x\r\n\r\n", [200]]
+        elsif r < 0.99 then ["POST /posts/#{rand(1..50_000)}/like HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer #{tokens[k]}\r\nContent-Length: 0\r\n\r\n", [200, 201]]
+        else
+          body = %({"body":"  a freshly written post body #{k}  "})
+          ["POST /posts HTTP/1.1\r\nHost: x\r\nAuthorization: Bearer #{tokens[k]}\r\nContent-Type: application/json\r\nContent-Length: #{body.bytesize}\r\n\r\n#{body}", [201]]
+        end
+      # The connection ends by the client hanging up, by Connection: close, or by HTTP/1.0.
+      c = rand
+      closing[k] = c < 0.16
+      if c >= 0.12 && c < 0.15 then request = request.sub("\r\nHost: x\r\n", "\r\nHost: x\r\nConnection: close\r\n")
+      elsif c >= 0.15 && c < 0.16 then request = request.sub(" HTTP/1.1\r\n", " HTTP/1.0\r\n")
+      end
+      s.write(request)
+    end
+    socks.each_with_index do |s, k|
+      bad += 1 unless expected[k].include?(read_response.call(s))
+      next unless closing[k]
+
+      s.close
+      socks[k] = connect.call
+    end
+  end
+  socks.each(&:close)
+  $stderr.puts "ruby_train: #{bad} unexpected responses" if bad.positive?
+  exit!(bad.zero? ? 0 : 1)
+rescue StandardError => error
+  $stderr.puts "ruby_train: client failed: #{error.class}: #{error.message}"
+  exit!(1)
+end
+done_w.close
+
+auth = "Authorization: Bearer #{tokens[0]}\r\n"
+warm = [
+  "GET /feed HTTP/1.1\r\nHost: x\r\n\r\n",
+  "GET /posts/1 HTTP/1.1\r\nHost: x\r\n\r\n",
+  "POST /posts HTTP/1.1\r\nHost: x\r\n#{auth}Content-Length: 11\r\n\r\n{\"body\":\"\"}",
+  "POST /posts/0/like HTTP/1.1\r\nHost: x\r\n#{auth}\r\n",
+  "GET /nope HTTP/1.0\r\nHost: x\r\n\r\n",
+  "GET /posts/abc HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"
+]
+server.warm(warm, WARM_ROUNDS)
+GC.compact
+Process.warmup if Process.respond_to?(:warmup)
+
+Async do |task|
+  task.async do
+    loop do
+      sleep 1
+      store.checkpoint
+    end
+  end
+  server.run(task)
+  done_r.wait_readable
+  task.stop
+end
+_, status = Process.wait2(client)
+abort "ruby_train: training client failed (exit #{status.exitstatus})" unless status.success?
+$stderr.puts "ruby_train: #{CLIENTS * ROUNDS} reactor requests + #{warm.size * WARM_ROUNDS} drained"
