diff --git a/server.rb b/server.rb
index b011fefdc2451ae93dd2c02a14b719e14085394d..0ed87e41a9bf7f21c2b35b3893f19071dda2ea54 100644
--- a/server.rb
+++ b/server.rb
@@ -31,9 +31,17 @@ Process.warmup if Process.respond_to?(:warmup)
 
 Async do |task|
   task.async do
+    tick = 0
+    peak = 0
     loop do
       sleep 1
       store.checkpoint
+      tick += 1
+      workers = server.instance_variable_get(:@workers)
+      peak = workers if workers > peak
+      if tick % 5 == 0
+        $stderr.puts "pool workers=#{workers} peak=#{peak} waiting=#{server.instance_variable_get(:@waiting)} queued=#{server.instance_variable_get(:@ready).size} open=#{server.open} commits=#{store.commits} minor_gc=#{GC.stat(:minor_gc_count)} major_gc=#{GC.stat(:major_gc_count)} gc_ms=#{GC.stat(:time)}"
+      end
     end
   end
 
