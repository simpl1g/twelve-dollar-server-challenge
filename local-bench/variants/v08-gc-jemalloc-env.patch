diff --git a/start.sh b/start.sh
index 37a9b85ca5fb58618c50e2dc8d029e70e8ea0d7d..f636e4cc1c201902be0e85ea7ac1ce42b2fc1287 100755
--- a/start.sh
+++ b/start.sh
@@ -5,6 +5,14 @@ cd "$(dirname "$0")"
 ulimit -Sn "$(ulimit -Hn)" 2>/dev/null || true
 export PATH="/opt/ruby/bin:$PATH"
 export RUBY_YJIT_ENABLE=1
+# Keep 40-90% of heap slots free after a GC (defaults 20-65%) and let old objects grow 4x (default 2x)
+# before a major: about half the minor GCs and fewer majors for ~10 MB more RSS. MIN < GOAL < MAX
+# must hold; Ruby silently ignores the ratios otherwise.
+export RUBY_GC_HEAP_FREE_SLOTS_MIN_RATIO=0.4 RUBY_GC_HEAP_FREE_SLOTS_GOAL_RATIO=0.6 \
+       RUBY_GC_HEAP_FREE_SLOTS_MAX_RATIO=0.9 RUBY_GC_HEAP_OLDOBJECT_LIMIT_FACTOR=4.0
+# jemalloc (linked into /opt/ruby) asks for transparent huge pages on its arenas and metadata. It is
+# a no-op unless /sys/kernel/mm/transparent_hugepage/enabled reads "madvise" (Ubuntu's default).
+export MALLOC_CONF="thp:always,metadata_thp:always"
 # Compile after 5 calls instead of 30, so paths the startup warm-up doesn't cover (error responses,
 # HTTP/1.0 clients) run compiled code almost at once.
 exec bundle exec ruby --yjit --yjit-call-threshold=5 server.rb
